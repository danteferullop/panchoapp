import 'package:flutter/material.dart';
import '../models/product.dart';
import '../services/firestore_service.dart';
import '../theme/app_theme.dart';
import '../widgets/glass_card.dart';
import '../widgets/product_card.dart';
import '../widgets/shimmer_box.dart';
import '../widgets/soft_club_app_bar.dart';
import 'cart_screen.dart';
import 'product_detail_screen.dart';

class CatalogScreen extends StatefulWidget {
  const CatalogScreen({super.key});

  @override
  State<CatalogScreen> createState() => _CatalogScreenState();
}

class _CatalogScreenState extends State<CatalogScreen> {
  String? _categoryFilter;
  String _sort = 'Latest drops';

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: SoftClubAppBar(
        onCartTap: () => Navigator.of(context).push(
          MaterialPageRoute(builder: (_) => const CartScreen()),
        ),
      ),
      body: StreamBuilder<List<Product>>(
        stream: FirestoreService.instance.streamProducts(),
        builder: (context, snapshot) {
          var products = snapshot.data ?? [];
          if (_categoryFilter != null) {
            products = products.where((p) => p.category == _categoryFilter).toList();
          }
          if (_sort == 'Precio: menor a mayor') {
            products.sort((a, b) => a.price.compareTo(b.price));
          } else if (_sort == 'Precio: mayor a menor') {
            products.sort((a, b) => b.price.compareTo(a.price));
          }

          return ListView(
            padding: const EdgeInsets.fromLTRB(16, 8, 16, 140),
            children: [
              Text('THE ARCHIVE', style: Theme.of(context).textTheme.displayLarge?.copyWith(fontSize: 26)),
              const SizedBox(height: 6),
              Text(
                'Explorá la colección líquida. Streetwear hiper-moderno forjado en la metrópolis nocturna.',
                style: Theme.of(context).textTheme.bodyMedium,
              ),
              const SizedBox(height: 18),
              Row(
                children: [
                  Expanded(
                    child: GestureDetector(
                      onTap: () => _openFilters(context),
                      child: GlassCard(
                        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                        borderRadius: 16,
                        child: Row(
                          children: [
                            const Icon(Icons.tune_rounded, size: 18, color: AppColors.accentGlossy),
                            const SizedBox(width: 8),
                            Text(_categoryFilter ?? 'Filtrar', style: Theme.of(context).textTheme.bodyMedium),
                          ],
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(width: 10),
                  Text(
                    '${products.length} items',
                    style: Theme.of(context).textTheme.bodyMedium,
                  ),
                ],
              ),
              const SizedBox(height: 18),
              if (!snapshot.hasData)
                GridView.count(
                  crossAxisCount: 2,
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  mainAxisSpacing: 14,
                  crossAxisSpacing: 14,
                  childAspectRatio: 0.68,
                  children: List.generate(4, (_) => const ShimmerBox(height: double.infinity)),
                )
              else
                GridView.builder(
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  itemCount: products.length,
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 2,
                    mainAxisSpacing: 14,
                    crossAxisSpacing: 14,
                    childAspectRatio: 0.68,
                  ),
                  itemBuilder: (context, i) => ProductCard(
                    product: products[i],
                    onTap: () => Navigator.of(context).push(
                      MaterialPageRoute(builder: (_) => ProductDetailScreen(product: products[i])),
                    ),
                  ),
                ),
            ],
          );
        },
      ),
    );
  }

  void _openFilters(BuildContext context) {
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.transparent,
      isScrollControlled: true,
      builder: (context) {
        final categories = ['Outerwear', 'Footwear', 'Accesorios'];
        final sorts = ['Latest drops', 'Precio: menor a mayor', 'Precio: mayor a menor'];
        return Padding(
          padding: const EdgeInsets.fromLTRB(16, 0, 16, 32),
          child: GlassCard(
            borderRadius: 28,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text('Categoría', style: Theme.of(context).textTheme.headlineMedium),
                const SizedBox(height: 12),
                Wrap(
                  spacing: 10,
                  runSpacing: 10,
                  children: categories.map((c) {
                    final selected = _categoryFilter == c;
                    return ChoiceChip(
                      label: Text(c),
                      selected: selected,
                      onSelected: (_) => setState(() {
                        _categoryFilter = selected ? null : c;
                        Navigator.pop(context);
                      }),
                      backgroundColor: AppColors.glassSurface,
                      selectedColor: AppColors.gradientEnd.withOpacity(0.4),
                      labelStyle: Theme.of(context).textTheme.bodyMedium,
                    );
                  }).toList(),
                ),
                const SizedBox(height: 20),
                Text('Ordenar por', style: Theme.of(context).textTheme.headlineMedium),
                const SizedBox(height: 12),
                Wrap(
                  spacing: 10,
                  runSpacing: 10,
                  children: sorts.map((s) {
                    final selected = _sort == s;
                    return ChoiceChip(
                      label: Text(s),
                      selected: selected,
                      onSelected: (_) => setState(() {
                        _sort = s;
                        Navigator.pop(context);
                      }),
                      backgroundColor: AppColors.glassSurface,
                      selectedColor: AppColors.gradientEnd.withOpacity(0.4),
                      labelStyle: Theme.of(context).textTheme.bodyMedium,
                    );
                  }).toList(),
                ),
              ],
            ),
          ),
        );
      },
    );
  }
}
