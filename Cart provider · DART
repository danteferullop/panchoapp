import 'package:flutter/foundation.dart';
import '../models/cart_item.dart';
import '../models/product.dart';

class CartProvider extends ChangeNotifier {
  final Map<String, CartItem> _items = {};

  List<CartItem> get items => _items.values.toList(growable: false);

  bool get isEmpty => _items.isEmpty;
  int get itemCount => _items.values.fold(0, (sum, item) => sum + item.quantity);

  double get productTotal =>
      _items.values.fold(0, (sum, item) => sum + item.subtotal);

  void addProduct(
    Product product, {
    required String size,
    required String color,
    int quantity = 1,
  }) {
    final key = '${product.id}_${size}_$color';
    if (_items.containsKey(key)) {
      _items[key]!.quantity += quantity;
    } else {
      _items[key] = CartItem(
        product: product,
        selectedSize: size,
        selectedColor: color,
        quantity: quantity,
      );
    }
    notifyListeners();
  }

  void updateQuantity(String variantKey, int quantity) {
    final item = _items[variantKey];
    if (item == null) return;
    if (quantity <= 0) {
      _items.remove(variantKey);
    } else {
      item.quantity = quantity;
    }
    notifyListeners();
  }

  void removeItem(String variantKey) {
    _items.remove(variantKey);
    notifyListeners();
  }

  void clear() {
    _items.clear();
    notifyListeners();
  }
}
